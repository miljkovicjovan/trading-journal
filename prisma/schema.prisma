generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id        Int      @id @default(autoincrement())
  symbol    String
  buyPrice  Float
  sellPrice Float
  pnl       Float
  qty       Int
  boughtAt  DateTime
  soldAt    DateTime
}
