generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id           Int      @id @default(autoincrement())
  symbol       String
  side         String
  type         String
  qty          Int
  limitPrice   Float?
  stopPrice    Float?
  takeProfit   Float?
  stopLoss     Float?
  avgFillPrice Float?
  status       String
  updateTime   DateTime
  orderId      String
  expiry       String?
  expiryTime   String?
  createdAt    DateTime @default(now())
}
