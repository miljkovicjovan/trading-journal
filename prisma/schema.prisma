generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id              Int       @id @default(autoincrement())
  symbol          String
  priceFormat     Int
  priceFormatType Int
  tickSize        Float
  buyFillId       String @unique
  sellFillId      String
  qty             Int
  buyPrice        Float
  sellPrice       Float
  pnl             Float
  boughtTimestamp DateTime
  soldTimestamp   DateTime
  duration        String
  createdAt       DateTime  @default(now())
}


